@model JsonElement[]
@{ViewData["Title"]="My results";}<span class="eyebrow">PERSONAL BESTS</span><h1>My race results</h1><div class="table-wrap"><table><thead><tr><th>Event</th><th>Category</th><th>Finish time</th><th>Position</th><th>Recorded</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.GetProperty("event").GetString()</td><td>@r.GetProperty("category").GetString()</td><td>@TimeSpan.FromMilliseconds(r.GetProperty("finishTimeMs").GetInt64()).ToString(@"hh\:mm\:ss")</td><td>@(r.GetProperty("overallPlacement").ValueKind==JsonValueKind.Null?"—":r.GetProperty("overallPlacement").GetInt32().ToString())</td><td>@r.GetProperty("recordedAt").GetDateTime().ToString("dd MMM yyyy")</td></tr>}</tbody></table></div>@if(Model.Length==0){<p class="empty">Your results will appear here after an organiser publishes them.</p>}
