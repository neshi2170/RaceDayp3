@model JsonElement[]
@{ViewData["Title"]="Participant dashboard";var enrolled=(JsonElement[])ViewBag.Enrolments;}
<span class="eyebrow">YOUR RACE JOURNEY</span><h1>Participant dashboard</h1><p class="muted">Find your next event and keep track of your enrolments.</p><div class="stats"><div class="stat"><b>@enrolled.Length</b><span>Your enrolments</span></div><div class="stat"><b>@Model.Length</b><span>Available events</span></div></div><h2>My enrolments</h2><div class="table-wrap"><table><thead><tr><th>Event</th><th>Category</th><th>Event date</th><th>Status</th></tr></thead><tbody>@foreach(var e in enrolled){<tr><td>@e.GetProperty("event").GetString()</td><td>@e.GetProperty("category").GetString()</td><td>@e.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy")</td><td><span class="pill">Enrolled</span></td></tr>}</tbody></table></div><h2>Explore events</h2><div class="cards">@foreach(var e in Model){<article class="panel"><span class="eyebrow">@e.GetProperty("eventType").GetString()</span><h3>@e.GetProperty("title").GetString()</h3><p>📍 @e.GetProperty("location").GetString()</p><p>@e.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy")</p><a class="text-link" asp-controller="Events" asp-action="Details" asp-route-id="@e.GetProperty("eventId").GetInt32()">View and enrol →</a></article>}</div>
