@model JsonElement
@{ViewData["Title"]="Event details";var id=Model.GetProperty("eventId").GetInt32();}
<a class="back" asp-controller="Home" asp-action="Index">← All events</a>@if(Model.TryGetProperty("bannerUrl",out var banner)&&banner.ValueKind==JsonValueKind.String){<img src="@banner.GetString()" alt="Event banner" style="width:100%;max-height:300px;object-fit:cover;border-radius:14px"/>}<section class="detail-hero"><span class="eyebrow">FEATURED RACE</span><h1>@Model.GetProperty("title").GetString()</h1><p>@Model.GetProperty("description").GetString()</p><div class="detail-meta"><span>📅 @Model.GetProperty("eventDate").GetDateTime().ToString("dddd, dd MMMM yyyy · HH:mm")</span><span>📍 @Model.GetProperty("location").GetString()</span><span>🏅 @Model.GetProperty("eventType").GetString()</span></div></section><h2>Available categories</h2><div class="cards">@foreach(var c in Model.GetProperty("categories").EnumerateArray()){<article class="panel"><h3>@c.GetProperty("categoryName").GetString()</h3><p>@c.GetProperty("distanceKm").GetDecimal() km · @c.GetProperty("ageGroup").GetString()</p><p class="price">R @c.GetProperty("entryFee").GetDecimal().ToString("N2")</p>@if(Context.Session.GetString("Role")=="Participant"){<form asp-controller="Events" asp-action="Enrol"><input type="hidden" name="CategoryId" value="@c.GetProperty("categoryId").GetInt32()"/><label>Emergency contact<input name="EmergencyContact" required placeholder="Name and phone number"/></label><button class="btn primary">Enrol now</button></form>}else if(Context.Session.GetString("Token")==null){<a class="btn primary" asp-controller="Account" asp-action="Login">Sign in to enrol</a>}</article>}</div>
