@model JsonElement[]
@{ViewData["Title"]="Upcoming events";}
<section class="hero"><div><span class="eyebrow">FIND YOUR NEXT FINISH LINE</span><h1>Every great journey<br/>starts at the <em>starting line.</em></h1><p>Discover local running, walking and cycling events. Choose your challenge and make race day yours.</p><a class="btn primary" href="#events">Explore events ↓</a></div><div class="hero-mark">🏃</div></section>
<section id="events"><form method="get" class="filter-bar"><select name="eventType"><option value="">All event types</option><option>Run</option><option>Walk</option><option>Cycle</option></select><input type="date" name="from" aria-label="From date"/><button class="btn">Filter events</button><a class="text-link" href="/">Clear filters</a></form><div class="section-head"><div><span class="eyebrow">THE RACE CALENDAR</span><h2>Upcoming events</h2></div><span class="muted">@Model.Length events listed</span></div><div class="cards">@foreach(var e in Model){<article class="event-card"><div class="event-image">@(e.TryGetProperty("eventType",out var t)?t.GetString():"Race")<span>RACEDAY</span></div><div class="event-content"><div class="event-date">@e.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy · HH:mm")</div><h3>@e.GetProperty("title").GetString()</h3><p>@e.GetProperty("description").GetString()</p><div class="muted">📍 @e.GetProperty("location").GetString()</div><a class="text-link" asp-controller="Events" asp-action="Details" asp-route-id="@e.GetProperty("eventId").GetInt32()">View event →</a></div></article>}</div>@if(Model.Length==0){<p class="empty">No upcoming events have been published yet.</p>}</section>
