@model ProfileVm
@{ViewData["Title"]="My profile";}<div class="form-wrap"><span class="eyebrow">YOUR ACCOUNT</span><h1>Profile settings</h1><p class="muted">@Model.Email · @Model.Role</p><form method="post"><div asp-validation-summary="All" class="validation"></div><label asp-for="FirstName">First name</label><input asp-for="FirstName"/><label asp-for="LastName">Last name</label><input asp-for="LastName"/><label asp-for="Phone">Phone</label><input asp-for="Phone"/><button class="btn primary">Save profile</button></form><h3>Profile picture</h3>@if(!string.IsNullOrWhiteSpace(Model.ProfileImageUrl)){<img src="@Model.ProfileImageUrl" alt="Profile picture" style="max-width:110px;border-radius:50%"/>}<form asp-action="Upload" method="post" enctype="multipart/form-data"><label>Choose an image (JPG, PNG or WebP; max 5 MB)</label><input type="file" name="file" accept="image/jpeg,image/png,image/webp" required/><button class="btn">Upload picture</button></form></div>
