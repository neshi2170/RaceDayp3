<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - RaceDay</title><link rel="stylesheet" href="~/css/site.css"/></head><body><header><a class="brand" asp-controller="Home" asp-action="Index">🏁 RaceDay</a><nav><a asp-controller="Home" asp-action="Index">Events</a>@if(Context.Session.GetString("Role")=="Organiser"){<a asp-controller="Organiser" asp-action="Index">Organiser dashboard</a>}@if(Context.Session.GetString("Role")=="Participant"){<a asp-controller="Participant" asp-action="Index">My dashboard</a><a asp-controller="Participant" asp-action="Results">My results</a>}@if(Context.Session.GetString("Token")!=null){<a asp-controller="Profile" asp-action="Index">Profile</a><a asp-controller="Account" asp-action="Logout">Sign out</a>}else{<a asp-controller="Account" asp-action="Login">Sign in</a><a class="nav-cta" asp-controller="Account" asp-action="Register">Register</a>}</nav></header><main>@if(TempData["Message"]!=null){<div class="alert success">@TempData["Message"]</div>}@if(TempData["Error"]!=null){<div class="alert error">@TempData["Error"]</div>}@RenderBody()</main><footer>RaceDay · Run together. Go further.</footer><script>document.querySelectorAll('[data-confirm]').forEach(x=>x.addEventListener('click',e=>{if(!confirm(x.dataset.confirm))e.preventDefault()}));</script>@await RenderSectionAsync("Scripts",required:false)</body></html>
