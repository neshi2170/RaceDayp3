@model List<(JsonElement Event,int Count)>
@{ViewData["Title"]="Organiser dashboard";}
<div class="section-head"><div><span class="eyebrow">RACE CONTROL</span><h1>Organiser dashboard</h1><p class="muted">Manage your events, entrants and race-day results.</p></div><a class="btn primary" asp-action="Create">＋ Create event</a></div><div class="stats"><div class="stat"><b>@Model.Count</b><span>Events listed</span></div><div class="stat"><b>@Model.Sum(x=>x.Count)</b><span>Total enrolments</span></div><div class="stat"><b>@Model.Count(x=>x.Event.GetProperty("eventDate").GetDateTime()>=DateTime.UtcNow)</b><span>Upcoming events</span></div></div><h2>Your event management</h2><div class="table-wrap"><table><thead><tr><th>Event</th><th>Date</th><th>Enrolments</th><th>Manage</th></tr></thead><tbody>@foreach(var row in Model){var id=row.Event.GetProperty("eventId").GetInt32();<tr><td><b>@row.Event.GetProperty("title").GetString()</b><small>@row.Event.GetProperty("location").GetString()</small></td><td>@row.Event.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy")</td><td>@row.Count</td><td class="actions"><a asp-action="Edit" asp-route-id="@id">Edit</a><a asp-action="Category" asp-route-id="@id">Add category</a><a asp-action="Enrolments" asp-route-id="@id">Entrants</a><a asp-action="Results" asp-route-id="@id">Results</a><form asp-action="Delete" asp-route-id="@id" method="post"><button class="link danger" data-confirm="Delete this event and its related data?">Delete</button></form></td></tr>}</tbody></table></div>
