@model CategoryVm
@{ViewData["Title"]="Add category";}<div class="form-wrap"><span class="eyebrow">EVENT CATEGORIES</span><h1>Add a category</h1><form method="post"><input asp-for="EventId" type="hidden"/><label asp-for="CategoryName">Category name</label><input asp-for="CategoryName" placeholder="10 km Open"/><label asp-for="DistanceKm">Distance (km)</label><input asp-for="DistanceKm" type="number" step="0.1"/><label asp-for="AgeGroup">Age group</label><input asp-for="AgeGroup" placeholder="18–35 / Open"/><label asp-for="EntryFee">Entry fee (R)</label><input asp-for="EntryFee" type="number" step="0.01"/><button class="btn primary">Add category</button></form></div>
