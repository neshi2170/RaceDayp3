@model EventVm
@{ViewData["Title"]="Create event";}<div class="form-wrap wide"><span class="eyebrow">EVENT SETUP</span><h1>Edit event</h1><form method="post"><div asp-validation-summary="All" class="validation"></div><label asp-for="Title">Event name</label><input asp-for="Title"/><label asp-for="Description">Description</label><textarea asp-for="Description" rows="4"></textarea><label asp-for="Location">Location</label><input asp-for="Location"/><label asp-for="EventDate">Date and time</label><input asp-for="EventDate" type="datetime-local"/><label asp-for="EventType">Event type</label><select asp-for="EventType"><option>Run</option><option>Walk</option><option>Cycle</option></select><button class="btn primary">Save event</button></form><h3>Event banner</h3><form asp-action="UploadBanner" method="post" enctype="multipart/form-data"><input type="hidden" name="eventId" value="@Model.EventId"/><label>Banner image (JPG, PNG or WebP; max 5 MB)</label><input type="file" name="file" accept="image/jpeg,image/png,image/webp" required/><button class="btn">Upload banner</button></form></div>
