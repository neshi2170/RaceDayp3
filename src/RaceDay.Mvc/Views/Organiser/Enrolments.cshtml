@model JsonElement[]
@{ViewData["Title"]="Event enrolments";}<h1>Enrolled participants</h1><p class="muted">Event #@ViewBag.EventId</p><div class="table-wrap"><table><thead><tr><th>Participant</th><th>Email</th><th>Category</th><th>Enrolled</th><th>Emergency contact</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.GetProperty("participant").GetString()</td><td>@p.GetProperty("email").GetString()</td><td>@p.GetProperty("category").GetString()</td><td>@p.GetProperty("enrolmentDate").GetDateTime().ToString("dd MMM yyyy")</td><td>@p.GetProperty("emergencyContact").GetString()</td></tr>}</tbody></table></div>
