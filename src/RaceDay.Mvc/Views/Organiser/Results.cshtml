@model JsonElement[]
@{ViewData["Title"]="Capture results";}<h1>Capture race results</h1><p class="muted">Event #@ViewBag.EventId · Enter each participant's finish time in milliseconds.</p><div class="table-wrap"><table><thead><tr><th>Participant</th><th>Category</th><th>Finish time (ms)</th><th>Position</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><form asp-action="SaveResult" method="post"><input type="hidden" name="enrolmentId" value="@p.GetProperty("enrolmentId").GetInt32()"/><input type="hidden" name="eventId" value="@ViewBag.EventId"/><td>@p.GetProperty("participant").GetString()</td><td>@p.GetProperty("category").GetString()</td><td><input name="finishTimeMs" type="number" min="1" required/></td><td><input name="overallPlacement" type="number" min="1"/></td><td><button class="btn small">Save result</button></td></form></tr>}</tbody></table></div>
